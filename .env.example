# ==========================================
# 사용법: cp .env.example .env  후 YOUR_* 값만 본인 것으로 교체
# - 비밀번호는 들어가지 않음 (SSO 브라우저 로그인)
# - 그래도 .env 는 gitignore 에 들어있으니 커밋되지 않음
# ==========================================

# ---------- Snowflake 연결 ----------
DBT_SNOWFLAKE_ACCOUNT=BVJAEKO-LA86305
DBT_SNOWFLAKE_USER=YOUR_ID@catchtable.co.kr
DBT_TARGET=dev
DBT_SNOWFLAKE_WAREHOUSE=dbt_dev_wh
DBT_SNOWFLAKE_DATABASE=WAD_DW_DEV

# (선택) 롤 명시 — 기본 로그인 롤에 스키마 권한이 없을 때
# DBT_SNOWFLAKE_ROLE=YOUR_ROLE

# 인증은 기본 SSO(externalbrowser). 비밀번호 쓰려면:
# DBT_SNOWFLAKE_PASSWORD=xxxxx

# ---------- 데이터 소스 (Amplitude / GA4) ----------
AMPLITUDE_DATABASE=WAD_DW_PROD
AMPLITUDE_SCHEMA=STAGING
AMPLITUDE_TABLE=STG_AMPLITUDE__AMPLITUDE_EVENTS

GA4_DATABASE=wad_dw
GA4_SCHEMA=dw
GA4_TABLE=ga4_events_flattend

# ---------- (선택) 일별 집계 mart ----------
# deploy/mart_setup.sql 로 본인 dev 스키마에 먼저 생성해야 사용 가능
# MART_DATABASE=WAD_DW_DEV
# MART_SCHEMA=YOUR_SCHEMA
# MART_TABLE=DIM_EVENT_DAILY_STATS

# ---------- 로그 설계서 (Google Sheets) ----------
SHEETS_URL=https://docs.google.com/spreadsheets/d/1UO5ySnU48lLS0VF-a8O1WRlKnKGEWi_8NUms4w24Al8/edit

# ──────────────────────────────────────────
# 시트 접근 인증 (시트 권한 상태에 따라)
# ──────────────────────────────────────────
# 공개 시트면 아무것도 설정 안 해도 자동으로 xlsx 경로 사용됨.
# 사내 전용 시트면 아래 중 하나 필요 ↓
#
# 방법 1 (권장) — 서비스 계정 JSON (kd01051 한테 DM 으로 받기)
#   service-account.json 을 프로젝트 루트에 놓고 아래 주석 해제
# GOOGLE_SERVICE_ACCOUNT_JSON=service-account.json
#
# 방법 2 — 사용자 OAuth (본인 Google 계정 로그인)
#   client_secret.json 을 프로젝트 루트에 놓고 아래 주석 해제
# GOOGLE_OAUTH_CLIENT_JSON=client_secret.json